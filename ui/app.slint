    in-out property <bool> native-available;
    in-out property <bool> keep-tray: true;
    in-out property <bool> applied-keep-tray: true;
    in-out property <bool> notifications: true;
    in-out property <bool> startup;
    in-out property <int> theme: 2;
    in-out property <int> history-index: 1;
    in-out property <bool> monthly;
    in-out property <bool> open-after;
    in-out property <bool> start-saving: true;
    in-out property <bool> advanced;
    in-out property <string> edit-id;
    in-out property <string> printer-name;
    in-out property <string> welcome-name: @tr("My PDF Printer");
    in-out property <string> folder;
    in-out property <string> pattern: "{title}_{date}_{counter}";
    changed pattern => { root.preview-pattern(); }
    in-out property <string> message;
    in-out property <string> search;
    in-out property <int> filter;
    in-out property <string> activity-search;
    in-out property <int> activity-filter;
    in property <[string]> activity-printers;
