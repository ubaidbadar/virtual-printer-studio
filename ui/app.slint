                Text { x: Tokens.px0; y: Tokens.px0; width: parent.width; height: Tokens.s7; text: @tr("New printer"); color: Tokens.text; font-size: Tokens.dialog-title; font-weight: Tokens.font-semibold; }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.s8; height: Tokens.s5; text: @tr("Anything you print to it is saved as a PDF automatically."); color: Tokens.secondary; font-size: Tokens.body; }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.px68; height: Tokens.s5; text: @tr("Printer name"); color: Tokens.text; font-size: Tokens.small; font-weight: Tokens.font-semibold; }
                StudioField { x: Tokens.px0; y: Tokens.px91; height: Tokens.control-height; width: parent.width; text <=> root.printer-name; placeholder-text: @tr("e.g. Invoices"); accessible-label: @tr("Printer name"); enabled: !root.busy; auto-focus: root.focus-name; }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.px143; height: Tokens.s5; text: @tr("Save PDFs to"); color: Tokens.text; font-size: Tokens.small; font-weight: Tokens.font-semibold; }
                StudioField { x: Tokens.px0; y: Tokens.px165; height: Tokens.control-height; width: parent.width - Tokens.px116; text <=> root.folder; accessible-label: @tr("Output folder"); enabled: !root.busy; }
                StudioButton { x: parent.width - Tokens.px108; y: Tokens.px165; width: Tokens.px108; text: @tr("Browse"); icon: @image-url("../assets/icons/folder.svg"); enabled: !root.busy; clicked => { root.browse(false); } }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.px217; height: Tokens.s5; text: @tr("File name"); color: Tokens.text; font-size: Tokens.small; font-weight: Tokens.font-semibold; }
                StudioField { x: Tokens.px0; y: Tokens.px239; height: Tokens.control-height; width: parent.width; text <=> root.pattern; accessible-label: @tr("File name pattern"); enabled: !root.busy; }
                HorizontalLayout { y: Tokens.px279; height: Tokens.px30; spacing: Tokens.px6; alignment: start;
                    FilterChip { font-size: Tokens.caption; text: @tr("+ Date"); enabled: !root.busy; clicked => { root.pattern += "{date}"; } }
                    FilterChip { font-size: Tokens.caption; text: @tr("+ Time"); enabled: !root.busy; clicked => { root.pattern += "{time}"; } }
                    FilterChip { font-size: Tokens.caption; text: @tr("+ Document title"); enabled: !root.busy; clicked => { root.pattern += "{title}"; } }
                    FilterChip { font-size: Tokens.caption; text: @tr("+ App name"); enabled: false; Tooltip { StudioHint { message: @tr("The source application name is not available for this print job."); } } }
                    FilterChip { font-size: Tokens.caption; text: @tr("+ Counter"); enabled: !root.busy; clicked => { root.pattern += "{counter}"; } }
