import { Button, LineEdit, ListView, ComboBox, Switch, ScrollView } from "std-widgets.slint";
import { Tokens } from "theme/tokens.slint";
import { PrinterCard, PrinterView } from "components/card.slint";
export { Tokens, PrinterView }
export struct ActivityView { printer: string, file: string, status: string, path: string, printer-id: string, failed: bool, date: string }
export component AppTray inherits SystemTrayIcon {
        visible: true;
        callback reopen(); callback retry(); callback settings(); callback quit();
        icon: @image-url("../assets/logo.svg");
        tooltip: @tr("Virtual Printer Studio — PDF capture");
        clicked => { root.reopen(); }
        Menu {
            MenuItem { title: @tr("Open Virtual Printer Studio"); activated => { root.reopen(); } }
            MenuItem { title: @tr("Retry pending PDFs"); activated => { root.retry(); } }
            MenuItem { title: @tr("Settings"); activated => { root.settings(); } }
            MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
        }
    }
export component AppWindow inherits Window {
    icon: @image-url("../assets/logo.svg");
    title: @tr("Virtual Printer Studio"); preferred-width: 1220px; preferred-height: 840px; min-width: 960px; min-height: 700px;
    background: Tokens.bg; default-font-size: 14px;
    in property <[PrinterView]> printers;
    in property <[[PrinterView]]> printer-rows;
    out property <int> columns: root.width >= 1150px ? 3 : 2;
    out property <length> card-width: (root.width - 278px - (root.columns - 1) * Tokens.gap) / root.columns;
    changed columns => { root.refresh(); }
    in property <[ActivityView]> activity;
    in property <bool> capture-running; in property <int> capture-port;
    in property <int> printer-count; in property <int> saved-count; in property <int> queued-count;
    in-out property <int> page: 0;
    in-out property <bool> editor: false;
    property <bool> modal-open: root.welcome || root.editor || root.confirm-clear;
    in-out property <bool> confirm-delete: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> welcome: true;
    in-out property <bool> busy: false;
    in-out property <bool> native-available;
    in-out property <bool> keep-tray: true;
    in-out property <bool> applied-keep-tray: true;
    in-out property <bool> notifications: true;
    in-out property <bool> startup;
    in-out property <int> theme: 2;
    in-out property <bool> monthly;
    in-out property <bool> open-after;
    in-out property <string> edit-id;
    in-out property <string> printer-name;
    in-out property <string> folder;
    in-out property <string> pattern: "{title}_{date}_{counter}";
    in-out property <string> message;
    in-out property <string> search;
    in-out property <int> filter;
    in-out property <string> activity-search;
    in-out property <int> activity-filter;
    in-out property <string> default-folder;
    in-out property <string> diagnostics;
    callback refresh();
    callback save-printer(string, string, string, string, bool, bool);
    callback select-printer(string);
    callback toggle-printer(string, bool);
    callback test-printer(string);
    callback delete-printer(string);
    callback repair-printer(string);
    callback browse(bool);
    callback open-path(string);
    callback show-folder(string);
    callback export-backup(); callback import-backup();
    callback save-settings(); callback retry(); callback clear-history();
    callback copy-diagnostics(); callback open-logs();
    callback dismiss-welcome(); callback reopen(); callback quit();
    diagnostic-copy := TextInput { visible: false; text: root.diagnostics; read-only: true; }
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 222px; background: Tokens.bg;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                Text { text: @tr("Virtual Printer Studio"); color: Tokens.text; font-weight: 600; height: 48px; }
                Button { enabled: !root.modal-open; text: @tr("Printers"); primary: root.page == 0; clicked => { root.page = 0; } }
                Button { enabled: !root.modal-open; text: @tr("Activity"); primary: root.page == 1; clicked => { root.page = 1; } }
                Button { enabled: !root.modal-open; text: @tr("Presets"); primary: root.page == 2; clicked => { root.page = 2; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: @tr("{} pending · v0.2", root.queued-count); color: Tokens.secondary; font-size: 12px; }
                Button { enabled: !root.modal-open; text: @tr("Settings"); primary: root.page == 3; clicked => { root.page = 3; } }
            }
        }
        VerticalLayout {
            padding: 28px; spacing: Tokens.gap;
            Text { text: root.page == 0 ? @tr("Printers") : root.page == 1 ? @tr("Activity") : root.page == 2 ? @tr("Presets") : @tr("Settings"); color: Tokens.text; font-size: 28px; font-weight: 600; }
            Text { text: @tr("{} printers · {} PDFs saved · {} pending", root.printer-count, root.saved-count, root.queued-count); color: Tokens.secondary; }
            if !root.native-available: Text { text: @tr("System printer installation requires Windows. Profile management and PDF delivery are available here."); color: Tokens.secondary; wrap: word-wrap; }
            if root.busy || root.message != "": Rectangle {
                min-height: 56px; background: Tokens.surface; border-radius: Tokens.radius;
                HorizontalLayout { padding: 12px; spacing: 12px;
                    Text { text: root.busy ? @tr("Working… Windows may ask for administrator access.") : root.message; color: Tokens.text; wrap: word-wrap; horizontal-stretch: 1; }
                    Button { enabled: !root.modal-open && (!root.busy); text: @tr("Dismiss"); clicked => { root.message = ""; } }
                }
            }
            if root.page == 0: VerticalLayout {
                spacing: Tokens.gap;
                HorizontalLayout { spacing: 8px;
                    LineEdit { enabled: !root.modal-open; placeholder-text: @tr("Search printers"); text <=> root.search; edited => { root.refresh(); } }
                    ComboBox { enabled: !root.modal-open; model: [@tr("All printers"), @tr("Active"), @tr("Needs attention")]; current-index <=> root.filter; selected => { root.refresh(); } }
                    Button { enabled: !root.modal-open && (!root.busy); text: @tr("+ New printer"); primary: true; clicked => { root.edit-id = ""; root.printer-name = ""; root.folder = root.default-folder; root.pattern = "{title}_{date}_{counter}"; root.monthly = false; root.open-after = false; root.message = ""; root.confirm-delete = false; root.editor = true; } }
                }
                if root.printers.length == 0: VerticalLayout { alignment: center;
                    Text { text: @tr("Your PDFs start here"); color: Tokens.text; font-size: 24px; horizontal-alignment: center; }
                    Text { text: @tr("Create a printer, or adjust your search."); color: Tokens.secondary; horizontal-alignment: center; }
                }
                ListView { for row in root.printer-rows: Rectangle { height: 182px;
                    HorizontalLayout { padding-bottom: Tokens.gap; spacing: Tokens.gap; alignment: start;
                        for printer in row: PrinterCard { width: root.card-width; horizontal-stretch: 0; printer: printer; busy: root.busy || root.modal-open;
                            details => { root.select-printer(printer.id); }
                            toggle(enabled) => { root.toggle-printer(printer.id, enabled); }
                            test => { root.test-printer(printer.id); }
                        }
                    }
                } }
            }
            if root.page == 1: VerticalLayout { spacing: Tokens.gap;
                HorizontalLayout { spacing: 8px;
                    LineEdit { enabled: !root.modal-open; text <=> root.activity-search; placeholder-text: @tr("Search activity"); edited => { root.refresh(); } }
                    ComboBox { enabled: !root.modal-open; model: [@tr("All activity"), @tr("Saved"), @tr("Failed")]; current-index <=> root.activity-filter; selected => { root.refresh(); } }
                    Button { enabled: !root.modal-open && (!root.busy); text: @tr("Retry pending"); clicked => { root.retry(); } }
                    Button { enabled: !root.modal-open && (!root.busy); text: @tr("Clear history"); clicked => { root.confirm-clear = true; } }
                }
                if root.activity.length == 0: Text { text: @tr("No matching activity. Print a document or try a test page."); color: Tokens.secondary; wrap: word-wrap; }
                ListView { for item in root.activity: Rectangle { height: 112px; background: Tokens.surface; border-color: Tokens.border; border-width: 1px; border-radius: Tokens.radius;
                    HorizontalLayout { padding: 16px; spacing: 16px;
                        VerticalLayout { Text { text: item.file; color: Tokens.text; font-weight: 600; overflow: elide; } Text { text: item.printer + " · " + item.date; color: Tokens.secondary; overflow: elide; } Text { text: item.status; color: Tokens.secondary; overflow: elide; } }
                        if !item.failed: Button { enabled: !root.modal-open; text: @tr("Open"); clicked => { root.open-path(item.path); } }
                        if !item.failed: Button { enabled: !root.modal-open; text: @tr("Show folder"); clicked => { root.show-folder(item.path); } }
                        if item.failed: Button { enabled: !root.modal-open && (!root.busy); text: @tr("Fix printer"); clicked => { root.select-printer(item.printer-id); } }
                    }
                } }
            }
            if root.page == 2: VerticalLayout { spacing: 16px;
                Text { text: @tr("Start with a useful preset"); color: Tokens.text; font-size: 20px; }
                Text { text: @tr("Choose a preset, then set the printer name and output folder."); color: Tokens.secondary; }
                for preset in [{name: @tr("Invoices"), pattern: "Invoice_{date}_{counter}"}, {name: @tr("Receipts"), pattern: "Receipt_{date}_{counter}"}, {name: @tr("Contracts"), pattern: "{title}_{date}"}, {name: @tr("Reports"), pattern: "Report_{date}_{time}"}]: Rectangle {
                    height: 80px; background: Tokens.surface; border-radius: Tokens.radius;
                    HorizontalLayout { padding: 16px; spacing: 16px;
                        Text { text: preset.name; color: Tokens.text; font-size: 17px; font-weight: 600; }
                        Text { text: preset.pattern; color: Tokens.secondary; }
                        Button { enabled: !root.modal-open && (!root.busy); text: @tr("Use preset"); clicked => { root.edit-id = ""; root.printer-name = preset.name; root.pattern = preset.pattern; root.folder = root.default-folder; root.monthly = false; root.open-after = false; root.confirm-delete = false; root.message = ""; root.editor = true; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 3: ScrollView { VerticalLayout { spacing: 20px; padding: 8px;
                Text { text: @tr("Startup and background printing"); color: Tokens.text; font-size: 18px; font-weight: 600; }
                Switch { enabled: !root.modal-open && (root.native-available); text: @tr("Start with Windows"); checked <=> root.startup; }
                Switch { enabled: !root.modal-open && (root.native-available); text: @tr("Keep processing in the tray when the window closes"); checked <=> root.keep-tray; }
                Switch { enabled: !root.modal-open && (root.native-available); text: @tr("Notify me when a PDF is saved"); checked <=> root.notifications; }
                Text { text: @tr("Appearance"); color: Tokens.text; font-size: 18px; font-weight: 600; }
                ComboBox { enabled: !root.modal-open; model: [@tr("Light"), @tr("Dark"), @tr("Use system setting")]; current-index <=> root.theme; }
                Text { text: @tr("Default output folder"); color: Tokens.text; }
                HorizontalLayout { spacing: 8px; LineEdit { enabled: !root.modal-open; text <=> root.default-folder; } Button { enabled: !root.modal-open; text: @tr("Browse"); clicked => { root.browse(true); } } }
                Button { enabled: !root.modal-open && (!root.busy); text: @tr("Save settings"); primary: true; clicked => { root.save-settings(); } }
                Text { text: @tr("Backup and recovery"); color: Tokens.text; font-size: 18px; font-weight: 600; }
                HorizontalLayout { spacing: 12px; Button { enabled: !root.modal-open && (!root.busy); text: @tr("Export printers"); clicked => { root.export-backup(); } } Button { enabled: !root.modal-open && (!root.busy); text: @tr("Import printers"); clicked => { root.import-backup(); } } Button { enabled: !root.modal-open && (!root.busy); text: @tr("Retry pending PDFs"); clicked => { root.retry(); } } }
                Text { text: @tr("Help"); color: Tokens.text; font-size: 18px; font-weight: 600; }
                HorizontalLayout { spacing: 12px; Button { enabled: !root.modal-open; text: @tr("Copy diagnostics"); clicked => { root.copy-diagnostics(); diagnostic-copy.select-all(); diagnostic-copy.copy(); } } Button { enabled: !root.modal-open; text: @tr("Open log folder"); clicked => { root.open-logs(); } } }
                Text { text: @tr("Virtual Printer Studio 0.2.0\nMade with Slint · https://slint.dev\n\nWindows printers use Microsoft Print to PDF and the built-in Standard TCP/IP monitor over authenticated local LPR. Captured jobs are retained until delivery is acknowledged. Keep the app running in the tray for immediate saving.\n\nReview the Slint licence before distribution."); color: Tokens.secondary; wrap: word-wrap; }
            } }
        }
    }
    if root.welcome || root.editor || root.confirm-clear: Rectangle { background: #00000066;
        TouchArea { }
        Rectangle { width: 620px; height: root.welcome || root.confirm-delete || root.confirm-clear ? 360px : 640px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Tokens.surface; border-radius: 12px;
            VerticalLayout { padding: 28px; spacing: 16px;
                if root.welcome: VerticalLayout { spacing: 20px;
                    Text { text: @tr("Welcome to Virtual Printer Studio"); color: Tokens.text; font-size: 26px; wrap: word-wrap; }
                    Text { text: @tr("Create a printer and choose where its PDFs go. On Windows, approve administrator access once to install it, then choose that printer from any application's Print dialog.\n\nKeep the app in the tray to save captured documents immediately. If the app is stopped, Windows keeps queued jobs until the app starts again."); color: Tokens.secondary; wrap: word-wrap; }
                    Button { enabled: !root.busy; text: @tr("Get started"); primary: true; clicked => { root.dismiss-welcome(); } }
                }
                if root.confirm-clear && !root.welcome: VerticalLayout { spacing: 20px;
                    Text { text: @tr("Clear activity history?"); color: Tokens.text; font-size: 24px; }
                    Text { text: @tr("Saved PDFs and pending captured documents will be kept."); color: Tokens.secondary; wrap: word-wrap; }
                    HorizontalLayout { spacing: 12px; Button { text: @tr("Cancel"); clicked => { root.confirm-clear = false; } } Button { enabled: !root.busy; text: @tr("Clear history"); clicked => { root.clear-history(); root.confirm-clear = false; } } }
                }
                if root.confirm-delete && !root.welcome: VerticalLayout { spacing: 20px;
                    Text { text: @tr("Delete this printer?"); color: Tokens.text; font-size: 24px; }
                    Text { text: @tr("The Windows printer and its profile will be removed. Saved PDFs and activity will be kept. Pending print jobs must be delivered or cancelled first."); color: Tokens.secondary; wrap: word-wrap; }
                    Text { text: root.message; color: Tokens.secondary; wrap: word-wrap; }
                    HorizontalLayout { spacing: 12px; Button { enabled: !root.busy; text: @tr("Cancel"); clicked => { root.confirm-delete = false; } } Button { enabled: !root.busy; text: @tr("Delete printer"); clicked => { root.delete-printer(root.edit-id); } } }
                }
                if root.editor && !root.welcome && !root.confirm-delete: VerticalLayout { spacing: 12px;
                    Text { text: root.edit-id == "" ? @tr("New printer") : @tr("Printer details"); color: Tokens.text; font-size: 24px; font-weight: 600; }
                    Text { text: @tr("Printer name"); color: Tokens.text; }
                    LineEdit { accessible-label: @tr("Printer name"); text <=> root.printer-name; placeholder-text: @tr("e.g. Invoices"); }
                    Text { text: @tr("Save PDFs to"); color: Tokens.text; }
                    HorizontalLayout { spacing: 8px; LineEdit { accessible-label: @tr("Output folder"); text <=> root.folder; } Button { text: @tr("Browse"); clicked => { root.browse(false); } } }
                    Text { text: @tr("File name pattern"); color: Tokens.text; }
                    LineEdit { accessible-label: @tr("File name pattern"); text <=> root.pattern; }
                    Text { text: @tr("Available: {{title}}, {{date}}, {{time}}, {{counter}}\nExisting files are never overwritten."); color: Tokens.secondary; wrap: word-wrap; }
                    Switch { text: @tr("Organise in monthly subfolders"); checked <=> root.monthly; }
                    Switch { text: @tr("Open each PDF after saving"); checked <=> root.open-after; }
                    if root.edit-id != "": HorizontalLayout { spacing: 8px;
                        if root.native-available: Button { enabled: !root.busy; text: @tr("Install or repair"); clicked => { root.repair-printer(root.edit-id); } }
                        Button { text: @tr("Open folder"); clicked => { root.open-path(root.folder); } }
                        Button { enabled: !root.busy; text: @tr("Print test page"); clicked => { root.test-printer(root.edit-id); } }
                    }
                    Text { text: root.busy ? @tr("Working… check for a Windows administrator prompt.") : root.message; color: Tokens.secondary; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px;
                        if root.edit-id != "": Button { enabled: !root.busy; text: @tr("Delete printer"); clicked => { root.confirm-delete = true; root.message = ""; } }
                        Button { enabled: !root.busy; text: @tr("Cancel"); clicked => { root.editor = false; } }
                        Button { enabled: !root.busy; text: @tr("Save printer"); primary: true; clicked => { root.save-printer(root.edit-id, root.printer-name, root.folder, root.pattern, root.monthly, root.open-after); } }
                    }
                }
            }
        }
    }
}
