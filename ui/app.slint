                        HorizontalLayout { padding-left: Tokens.s4; padding-right: Tokens.s4; spacing: Tokens.s3;
                            Text { text: @tr("{} can't save PDFs.", root.attention-name); color: Tokens.danger-fg; font-size: Tokens.body; font-weight: Tokens.font-semibold; vertical-alignment: center; }
                            Text { text: @tr("The folder {} wasn't found.", root.attention-folder); color: Tokens.text; font-size: Tokens.body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            StudioButton { text: @tr("Choose a new folder"); enabled: !root.modal-open && !root.busy; clicked => { root.choose-folder(root.attention-id); } }
                        }
                    }
                    HorizontalLayout { height: Tokens.control-height; spacing: Tokens.s2; alignment: start;
                        FilterChip { text: @tr("All {}", root.printer-count); selected: root.filter == 0; enabled: !root.modal-open; clicked => { root.filter = 0; root.refresh(); } }
                        FilterChip { text: @tr("Active {}", root.active-count); selected: root.filter == 1; enabled: !root.modal-open; clicked => { root.filter = 1; root.refresh(); } }
                        FilterChip { text: @tr("Needs attention {}", root.attention-count); selected: root.filter == 2; enabled: !root.modal-open; clicked => { root.filter = 2; root.refresh(); } }
                    }
                    ListView { for row in root.printer-rows: Rectangle { height: Tokens.card-height + Tokens.s4;
                        HorizontalLayout { spacing: Tokens.s4; padding-bottom: Tokens.s4; alignment: start;
                            for printer in row: Rectangle { width: root.card-width; height: Tokens.card-height; horizontal-stretch: 0;
                                if !printer.is-new: PrinterCard { printer: printer; busy: root.busy || root.modal-open;
                                    details => { root.select-printer(printer.id); }
                                    toggle(value) => { root.toggle-printer(printer.id, value); }
                                    test => { root.test-printer(printer.id); }
                                    open-folder => { root.open-path(printer.folder); }
                                }
                                if printer.is-new: Rectangle {
                                    Image { width: parent.width; height: parent.height; source: @image-url("../assets/new-card.svg"); image-fit: fill; }
                                    Image { x: (parent.width - Tokens.s6) / 2; y: Tokens.px68; width: Tokens.s6; height: Tokens.s6; source: @image-url("../assets/icons/plus.svg"); colorize: Tokens.accent-text; }
                                    Text { x: Tokens.px0; width: parent.width; y: Tokens.px96; height: Tokens.s6; text: @tr("New printer"); color: Tokens.accent-text; font-size: Tokens.body; font-weight: Tokens.font-semibold; horizontal-alignment: center; }
                                    accessible-role: button; accessible-label: @tr("Create another printer"); accessible-enabled: !root.modal-open && !root.busy;
                                    accessible-action-default => { if !root.modal-open && !root.busy { root.new-printer(); } }
                                    TouchArea { enabled: !root.modal-open && !root.busy; clicked => { root.new-printer(); } }
