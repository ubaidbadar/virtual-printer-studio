            }
        }
        main := Rectangle { x: Tokens.nav-width + Tokens.page-gutter; y: Tokens.s4; width: parent.width - self.x - Tokens.page-right; height: parent.height - Tokens.s8;
            if root.detail-open: DetailPage {
                name <=> root.printer-name; folder <=> root.folder; pattern <=> root.pattern; monthly <=> root.monthly; open-after <=> root.open-after; notifications <=> root.notifications;
                preview: root.pattern-preview; status: root.detail-status; enabled: root.detail-enabled;
                folder-ok: root.detail-folder-ok; write-ok: root.detail-write-ok; capture-ok: root.detail-service-ok; space-ok: root.detail-space-ok;
                free-space: root.detail-free-space; busy: root.busy || root.modal-open; native-available: root.native-available; recent: root.recent-files;
                back => { root.editor = false; root.message = ""; }
                browse => { root.browse(false); }
                save => { root.save-profile(); }
                test => { root.test-printer(root.edit-id); }
                open => { root.open-path(root.folder); }
                file(path) => { root.open-path(path); }
                toggle(value) => { root.toggle-printer(root.edit-id, value); }
                repair => { root.repair-printer(root.edit-id); }
                delete => { root.confirm-delete = true; root.message = ""; }
                notify => { root.save-settings(); }
            }
            if !root.detail-open: Rectangle {
                Text { x: Tokens.px0; y: Tokens.px0; width: parent.width; height: Tokens.px38; text: root.page == 0 ? @tr("Printers") : root.page == 1 ? @tr("Activity") : root.page == 2 ? @tr("Presets") : @tr("Settings"); color: Tokens.text; font-size: Tokens.title; font-weight: Tokens.font-semibold; }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.px38; height: Tokens.s5; text: root.page == 0 ? @tr("{} virtual printers · {} PDFs saved today", root.printer-count, root.saved-count) : root.page == 1 ? @tr("Everything your printers have saved") : root.page == 2 ? @tr("Start with a setup that works for you") : @tr("Make Virtual Printer Studio work your way"); color: Tokens.secondary; font-size: Tokens.body; }
                if root.page == 0: HorizontalLayout { x: parent.width - Tokens.px409; y: Tokens.px23; width: Tokens.px409; height: Tokens.control-height; spacing: Tokens.s4;
                    StudioField { width: Tokens.px260; height: Tokens.control-height; enabled: !root.modal-open; leading-icon: @image-url("../assets/icons/search.svg"); placeholder-text: @tr("Search printers"); text <=> root.search; edited => { root.refresh(); } }
                    StudioButton { width: Tokens.px133; text: @tr("New printer"); label: @tr("+ New printer"); icon: @image-url("../assets/icons/plus.svg"); primary: true; enabled: !root.modal-open && !root.busy; clicked => { root.new-printer(); } }
                }
                if root.page == 1: HorizontalLayout { x: parent.width - Tokens.px504; y: root.width < Tokens.px1150 ? Tokens.px75 : Tokens.px23; width: Tokens.px504; height: Tokens.control-height; spacing: Tokens.s3;
                    StudioField { width: Tokens.px220; enabled: !root.modal-open; leading-icon: @image-url("../assets/icons/search.svg"); placeholder-text: @tr("Search files"); text <=> root.activity-search; edited => { root.refresh(); } }
                    StudioSelect { width: Tokens.px140; enabled: !root.modal-open; model: root.activity-printers; current-index <=> root.activity-printer; selected => { root.refresh(); } }
                    StudioButton { width: Tokens.px120; text: root.activity-date == 0 ? @tr("Today") : root.activity-date == 1 ? @tr("All dates") : @tr("Last 7 days"); label: @tr("Activity actions"); trailing-icon: @image-url("../assets/icons/chevron.svg"); horizontal-padding: Tokens.s3; left-aligned: true; enabled: !root.modal-open; clicked => { history-actions.show(); } }
                }
                history-actions := PopupWindow { x: parent.width - Tokens.px180; y: Tokens.px56; width: Tokens.px180; height: Tokens.px300;
                    Rectangle { background: Tokens.surface; border-width: Tokens.hairline; border-color: Tokens.border; border-radius: Tokens.radius;
                        VerticalLayout { padding: Tokens.s1; spacing: Tokens.s1;
                            for date[i] in [@tr("Today"), @tr("All dates"), @tr("Last 7 days")]: StudioButton { text: date; quiet: true; left-aligned: true; clicked => { root.activity-date = i; history-actions.close(); root.refresh(); } }
                            for status[i] in [@tr("All activity"), @tr("Saved only"), @tr("Failed only")]: StudioButton { text: status; quiet: true; left-aligned: true; clicked => { root.activity-filter = i; history-actions.close(); root.refresh(); } }
                            StudioButton { text: @tr("Retry pending"); quiet: true; clicked => { history-actions.close(); root.retry(); } }
                            StudioButton { text: @tr("Clear history"); quiet: true; clicked => { history-actions.close(); root.confirm-clear = true; } }
