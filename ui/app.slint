    }
    if root.showcase == 0 && !root.welcome: Rectangle {
        Rectangle { x: Tokens.px0; y: Tokens.px0; height: parent.height; width: Tokens.nav-width;
            VerticalLayout { padding: Tokens.s2; spacing: Tokens.px2;
                NavItem { text: @tr("Printers"); icon: @image-url("../assets/icons/printer.svg"); selected: root.page == 0; enabled: !root.modal-open; clicked => { root.navigate(0); } }
                NavItem { text: @tr("Activity"); icon: @image-url("../assets/icons/activity.svg"); selected: root.page == 1; enabled: !root.modal-open; clicked => { root.navigate(1); } }
                NavItem { text: @tr("Presets"); icon: @image-url("../assets/icons/presets.svg"); selected: root.page == 2; enabled: !root.modal-open; clicked => { root.navigate(2); } }
                Rectangle { vertical-stretch: 1; }
