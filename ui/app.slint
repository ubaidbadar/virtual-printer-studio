                    Text { x: Tokens.px72; width: parent.width - Tokens.px84; text: root.pattern-preview; color: Tokens.text; font-size: Tokens.small; font-weight: Tokens.font-semibold; vertical-alignment: center; overflow: elide; }
                }
                Text { x: Tokens.px0; width: parent.width; y: Tokens.px381; height: Tokens.s8; text: @tr("Start saving right away"); color: Tokens.text; font-size: Tokens.body; vertical-alignment: center; }
                StudioToggle { x: parent.width - Tokens.toggle-width; y: Tokens.px379; checked <=> root.start-saving; label: @tr("Start saving right away"); enabled: !root.busy; }
                StudioButton { x: Tokens.px0; y: Tokens.px419; text: @tr("Advanced options"); icon: @image-url("../assets/icons/chevron.svg"); quiet: true; enabled: !root.busy; clicked => { root.advanced = !root.advanced; } }
                if root.advanced: HorizontalLayout { y: Tokens.px459; height: Tokens.px70; spacing: Tokens.s4;
                    Text { text: @tr("Organise in monthly subfolders"); color: Tokens.text; font-size: Tokens.small; }
                    StudioToggle { checked <=> root.monthly; label: @tr("Organise in monthly subfolders"); }
                    Text { text: @tr("Open after saving"); color: Tokens.text; font-size: Tokens.small; }
                    StudioToggle { checked <=> root.open-after; label: @tr("Open each PDF after saving"); }
                }
                Text { x: Tokens.px0; y: parent.height - Tokens.px36; width: parent.width - Tokens.px220; height: Tokens.px40; text: root.busy ? @tr("Working… check for an administrator prompt.") : root.message != "" ? root.message : @tr("The system may ask for administrator permission\nonce."); color: root.message == "" ? Tokens.secondary : Tokens.danger-fg; font-size: Tokens.caption; wrap: word-wrap; }
                StudioButton { x: parent.width - Tokens.px210; y: parent.height - Tokens.control-height; width: Tokens.px78; text: @tr("Cancel"); enabled: !root.busy; clicked => { root.editor = false; } }
                StudioButton { x: parent.width - Tokens.px124; y: parent.height - Tokens.control-height; width: Tokens.px124; text: @tr("Create printer"); label: @tr("Save printer"); primary: true; enabled: !root.busy; clicked => { root.save-profile(); } }
            }
            if root.confirm-delete || root.confirm-clear: VerticalLayout { padding: Tokens.s7; spacing: Tokens.s4;
                Text { text: root.confirm-delete ? @tr("Delete this printer?") : @tr("Clear activity history?"); color: Tokens.text; font-size: Tokens.dialog-title; font-weight: Tokens.font-semibold; }
                Text { text: root.confirm-delete ? @tr("The system printer and its profile will be removed. Saved PDFs and activity will be kept. Deliver or cancel pending print jobs first.") : @tr("Saved PDFs and pending captured documents will be kept."); color: Tokens.secondary; font-size: Tokens.body; wrap: word-wrap; }
                Text { text: root.message; color: Tokens.danger-fg; font-size: Tokens.small; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: Tokens.s2;
                    StudioButton { text: @tr("Cancel"); enabled: !root.busy; clicked => { root.confirm-delete = false; root.confirm-clear = false; } }
                    StudioButton { text: root.confirm-delete ? @tr("Delete printer") : @tr("Clear history"); primary: true; enabled: !root.busy; clicked => { if root.confirm-delete { root.delete-printer(root.edit-id); } else { root.clear-history(); root.confirm-clear = false; } } }
                }
            }
        }
    }
    }
}
