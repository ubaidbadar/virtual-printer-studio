                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.page == 3: SettingsPage { y: Tokens.px75; height: parent.height - Tokens.px75;
                    startup <=> root.startup; tray <=> root.keep-tray; notifications <=> root.notifications; theme <=> root.theme; history <=> root.history-index; folder <=> root.default-folder;
                    native-available: root.native-available; macos: root.macos; disabled: root.modal-open || root.busy;
                    save => { root.save-settings(); } browse => { root.browse(true); }
                    export => { root.export-backup(); } import => { root.import-backup(); }
