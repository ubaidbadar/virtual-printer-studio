    in-out property <int> activity-date;
    in-out property <string> default-folder;
    in-out property <string> diagnostics;
    callback refresh(); callback preview-pattern();
    callback save-printer(string, string, string, string, bool, bool, bool);
    callback select-printer(string); callback choose-folder(string);
    callback toggle-printer(string, bool); callback test-printer(string); callback delete-printer(string); callback repair-printer(string);
    callback toggle-all-printers(bool);
    callback show-tray();
    callback browse(bool); callback open-path(string); callback show-folder(string);
    callback export-backup(); callback import-backup(); callback save-settings(); callback retry(); callback clear-history();
    callback copy-diagnostics(); callback open-logs(); callback dismiss-welcome(); callback reopen(); callback quit();
    function new-printer() {
        root.edit-id = ""; root.printer-name = ""; root.folder = root.default-folder;
        root.pattern = "{title}_{date}_{counter}"; root.monthly = false; root.open-after = false;
        root.message = ""; root.confirm-delete = false; root.advanced = false; root.start-saving = true; root.focus-name = true; root.editor = true;
    }
    function save-profile() { root.save-printer(root.edit-id, root.printer-name, root.folder, root.pattern, root.monthly, root.open-after, root.start-saving); }
    function navigate(page: int) { root.editor = false; root.page = page; root.message = ""; }
    keys := FocusScope { x: Tokens.px0; y: Tokens.px0; width: root.width; height: root.height;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.modifiers.control && event.modifiers.shift && (event.text == "t" || event.text == "T") {
                root.show-tray(); return accept;
            }
            if event.text == Key.Escape {
                if root.confirm-delete { root.confirm-delete = false; return accept; }
                if root.confirm-clear { root.confirm-clear = false; return accept; }
                if root.editor { root.editor = false; root.message = ""; return accept; }
