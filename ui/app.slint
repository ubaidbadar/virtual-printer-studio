import { ListView } from "std-widgets.slint";
import { Tokens } from "theme/tokens.slint";
import { PrinterCard, PrinterView } from "components/card.slint";
import { StudioHint, StudioSelect, StudioField, StudioButton, StudioToggle, FilterChip, NavItem } from "components/controls.slint";
import { ActivityView } from "state.slint";
import { ActivityPage } from "pages/activity.slint";
import { SettingsPage } from "pages/settings.slint";
import { DetailPage } from "pages/detail.slint";
import { WelcomePage } from "pages/welcome.slint";
import { BrandBoard, TrayBoard } from "pages/brand.slint";
import { TrayWindow } from "components/tray.slint";
export { Tokens, PrinterView, ActivityView }
export { TrayWindow }

export component AppTray inherits SystemTrayIcon {
    visible: true;
    callback reopen(); callback popup(); callback retry(); callback settings(); callback quit();
    icon: @image-url("../assets/logo-small.svg");
    tooltip: @tr("Virtual Printer Studio — PDF capture");
    clicked => { root.popup(); }
    Menu {
        MenuItem { title: @tr("Open Virtual Printer Studio"); activated => { root.reopen(); } }
        MenuItem { title: @tr("Retry pending PDFs"); activated => { root.retry(); } }
        MenuItem { title: @tr("Settings"); activated => { root.settings(); } }
        MenuItem { title: @tr("Quit"); activated => { root.quit(); } }
    }
}
export component AppWindow inherits Window {
    icon: @image-url("../assets/logo.svg");
    title: @tr("Virtual Printer Studio");
    preferred-width: Tokens.px1280; preferred-height: Tokens.px760; min-width: Tokens.px960; min-height: Tokens.px660;
    background: Tokens.bg; default-font-size: Tokens.body; default-font-family: Tokens.font-family;
    in property <[PrinterView]> printers;
    in property <[[PrinterView]]> printer-rows;
    in property <[ActivityView]> activity;
    in property <[ActivityView]> recent-files;
    in property <[ActivityView]> tray-files;
    in property <bool> any-enabled;
    in-out property <int> showcase;
    out property <int> columns: root.width >= Tokens.px1150 ? 3 : 2;
    out property <length> card-width: (root.width - Tokens.nav-width - Tokens.page-gutter - Tokens.page-right - (root.columns - 1) * Tokens.gap) / root.columns;
    changed columns => { root.refresh(); }
    in property <bool> capture-running; in property <int> capture-port;
    in property <int> printer-count; in property <int> saved-count; in property <int> queued-count;
    in property <int> active-count; in property <int> attention-count; in property <int> failed-count;
    in property <string> saved-space: "0 KB";
    in property <string> attention-id; in property <string> attention-name; in property <string> attention-folder;
    in property <string> detail-status: "Ready";
    in property <bool> detail-enabled: true;
    in property <bool> detail-folder-ok; in property <bool> detail-write-ok;
    in property <bool> detail-service-ok; in property <bool> detail-space-ok;
    in property <string> detail-free-space: @tr("Storage available");
    in-out property <string> pattern-preview;
    in-out property <int> page: 0;
    in-out property <bool> editor: false;
    in-out property <bool> focus-name;
    changed editor => { if !root.editor || root.edit-id != "" { keys.focus(); } }
    property <bool> detail-open: root.editor && root.edit-id != "";
    property <bool> modal-open: root.welcome || (root.editor && root.edit-id == "") || root.confirm-clear || root.confirm-delete;
    in-out property <bool> confirm-delete: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> welcome: true;
    in-out property <bool> busy: false;
