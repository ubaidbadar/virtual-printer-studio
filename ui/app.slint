                HorizontalLayout { padding: Tokens.s3; spacing: Tokens.s3;
                    Text { text: root.busy ? @tr("Working… check for an administrator prompt.") : root.message; color: Tokens.text; font-size: Tokens.small; wrap: word-wrap; horizontal-stretch: 1; }
                    StudioButton { text: @tr("Dismiss"); enabled: !root.busy; clicked => { root.message = ""; } }
                }
            }
        }
    }
    if !root.welcome && ((root.editor && root.edit-id == "") || root.confirm-delete || root.confirm-clear): Rectangle {
        background: Tokens.overlay; TouchArea { }
        Image { x: dialog.x - Tokens.px60; y: dialog.y - Tokens.px40; width: dialog.width + Tokens.px120; height: dialog.height + Tokens.px120; source: @image-url("../assets/dialog-shadow.svg"); image-fit: fill; }
