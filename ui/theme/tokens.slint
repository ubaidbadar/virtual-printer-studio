import { Palette } from "std-widgets.slint";
export global Tokens {
    in-out property <bool> dark: false;
    changed dark => { Palette.color-scheme = Tokens.dark ? ColorScheme.dark : ColorScheme.light; }
    out property <color> bg: dark ? #202020 : #f3f3f3;
    out property <color> surface: dark ? #2b2b2b : white;
    out property <color> text: dark ? #f5f5f5 : #1f1f1f;
    out property <color> secondary: dark ? #c8c8c8 : #5c5c5c;
    out property <color> border: dark ? #444 : #e5e5e5;
    out property <color> accent: #0f6cbd;
    out property <length> gap: 16px;
    out property <length> radius: 8px;
}
